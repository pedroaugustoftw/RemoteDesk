<Window x:Class="RemoteDesk.ServerSetup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RemoteDesk Server — Instalação" Width="1280" Height="880" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#111213" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="14" Icon="RemoteDesk.ico" UseLayoutRounding="True">
<Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="#1F1F1F"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#555555" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A8A8A8"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#131313"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#444444"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#1D6FF2"/><Setter Property="SelectionBrush" Value="#8E302D"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="ReadField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Cursor" Value="IBeam"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#4A4A4A"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="40"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B0B0B0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#1D6FF2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1F1F1F"/><Setter Property="BorderBrush" Value="#333333"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="215"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#141516" BorderBrush="#2A2B2D" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0"><Image Source="RemoteDesk.ico" Width="32" Height="32" Margin="0,0,12,0"/><StackPanel><TextBlock Text="RemoteDesk" FontSize="19" FontWeight="Bold"/><TextBlock Text="Server" FontSize="20" Foreground="#8F949A"/></StackPanel></StackPanel><StackPanel Grid.Row="1" Margin="12,10"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="16,14"/></Style></StackPanel.Resources><Button Content="▤   Instalação" Click="InstallationPage_Click" Background="#252729" BorderBrush="#1D6FF2" BorderThickness="4,0,0,0"/><Button Content="▥   Status" Click="StatusPage_Click"/><Button Content="⚙   Configurações" Click="NetworkPage_Click"/><Button Content="ⓘ   Sobre" Click="About_Click"/></StackPanel><StackPanel Grid.Row="2" Margin="22,20"><TextBlock x:Name="ServiceState" Text="Consultando…" FontWeight="SemiBold"/><TextBlock Text="Serviço Windows" Foreground="#8F949A" FontSize="12" Margin="0,5,0,0"/></StackPanel></Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border BorderBrush="#2B2D30" BorderThickness="0,0,0,1" Padding="22,14"><StackPanel><TextBlock Text="Instalação e configuração" FontSize="23" FontWeight="Bold"/><TextBlock Text="Configure o servidor e obtenha os dados para conectar os clientes." Foreground="#B4B8BE" Margin="0,7,0,0" FontSize="16"/></StackPanel></Border>
<Border x:Name="ServiceCard" Grid.Row="1" Background="#191A1C" BorderBrush="#303236" BorderThickness="0,0,0,1" Padding="22,10"><StackPanel>
<TextBlock x:Name="ServiceSummary" FontSize="15" FontWeight="SemiBold"/>
<WrapPanel x:Name="Actions" Margin="0,8,0,0"><Button x:Name="InstallButton" Content="Instalar e iniciar" Click="Install_Click" Background="#1D6FF2" BorderBrush="#1D6FF2" Margin="0,0,8,6"/><Button x:Name="StartButton" Content="Iniciar servidor" Click="Start_Click" Background="#1D6FF2" Margin="0,0,8,6"/><Button x:Name="StopButton" Content="Parar servidor" Click="Stop_Click" Margin="0,0,8,6"/><Button x:Name="RemoveButton" Content="Remover serviço" Click="Remove_Click" Margin="0,0,8,6"/></WrapPanel>
<TextBlock x:Name="ServiceActionHint" FontSize="12" Foreground="#B4B8BE"/>
</StackPanel></Border>
<ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,20"><StackPanel>
<Border x:Name="NetworkCard" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
<TextBlock Text="Modo de conexão" FontSize="22" FontWeight="SemiBold"/>
<ComboBox x:Name="NetworkMode" SelectedIndex="0" Margin="0,14,0,12" Padding="8" SelectionChanged="NetworkMode_Changed"><ComboBoxItem Content="Rede local (LAN)"/><ComboBoxItem Content="VPS / domínio / Cloudflare"/></ComboBox>
<StackPanel x:Name="LocalFields">
<TextBlock Text="IPv4 do computador servidor" Style="{StaticResource Label}"/><TextBox x:Name="IpField" MaxWidth="320" HorizontalAlignment="Left" MinWidth="180"/>
<TextBlock Text="Use os endereços e as SHA abaixo nos aplicativos da sua rede. O IP e o certificado existentes são preservados nas atualizações." FontSize="12" Margin="0,10,0,0"/>
<Button x:Name="FirewallButton" Content="Configurar firewall LAN" Click="Firewall_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
</StackPanel>
<StackPanel x:Name="PublicFields" Visibility="Collapsed">
<TextBlock Text="Servidor público (wss://dominio/ws)" Style="{StaticResource Label}"/><TextBox x:Name="PublicServerField" Margin="0,0,0,12"/>
<TextBlock Text="Relay público (wss://dominio/relay/ws)" Style="{StaticResource Label}"/><TextBox x:Name="PublicRelayField" Margin="0,0,0,12"/>
<TextBlock Text="Porta HTTP local do túnel" Style="{StaticResource Label}"/><TextBox x:Name="TunnelPortField" Text="2750"/>
<TextBlock Text="Cloudflare Tunnel: HTTP → localhost:2750. O gateway aceita /ws e /relay/ws. Com certificado público, deixe as SHA vazias no cliente. Não exponha a porta administrativa 5092." Foreground="#B4B8BE" Margin="0,12,0,0"/>
</StackPanel>
<Button x:Name="SaveNetworkButton" Content="Aplicar configuração" Click="SaveNetwork_Click" Background="#1D6FF2" HorizontalAlignment="Left" Margin="0,14,0,0"/>
<TextBlock x:Name="NetworkSaveHint" Text="Escolha o modo, preencha os campos e clique em Instalar e iniciar acima." FontSize="12" Margin="0,10,0,0"/>
</StackPanel></Border>
<Grid x:Name="EndpointGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="ServerCard" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="▤   Servidor" FontSize="25" FontWeight="Bold"/><TextBlock Text="Identificação e autorização das conexões" Foreground="#A8A8A8" Margin="0,8,0,30"/>
<TextBlock Text="ENDEREÇO DE CONEXÃO" Style="{StaticResource Label}"/><TextBox x:Name="ServerAddress" Style="{StaticResource ReadField}" FontSize="17" MinHeight="48"/><Button Content="▣   Copiar endereço" Tag="server" Click="Copy_Click" Margin="0,10,0,28"/>
<TextBlock Text="CERTIFICADO LAN · SHA-256" Style="{StaticResource Label}"/><TextBox x:Name="ServerFingerprint" Style="{StaticResource ReadField}" FontSize="13" FontFamily="Consolas" MinHeight="76"/><Button Content="▣   Copiar SHA-256" Tag="serverHash" Click="Copy_Click" Margin="0,10,0,0"/></StackPanel></Border>
<Border x:Name="RelayCard" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="♧   Relay" FontSize="25" FontWeight="Bold"/><TextBlock Text="Transmissão da sessão autorizada" Foreground="#A8A8A8" Margin="0,8,0,30"/>
<TextBlock Text="ENDEREÇO DE TRANSMISSÃO" Style="{StaticResource Label}"/><TextBox x:Name="RelayAddress" Style="{StaticResource ReadField}" FontSize="17" MinHeight="48"/><Button Content="▣   Copiar endereço" Tag="relay" Click="Copy_Click" Margin="0,10,0,28"/>
<TextBlock Text="CERTIFICADO LAN · SHA-256" Style="{StaticResource Label}"/><TextBox x:Name="RelayFingerprint" Style="{StaticResource ReadField}" FontSize="13" FontFamily="Consolas" MinHeight="76"/><Button Content="▣   Copiar SHA-256" Tag="relayHash" Click="Copy_Click" Margin="0,10,0,0"/></StackPanel></Border></Grid>
<Border x:Name="LocalHintCard" Style="{StaticResource Card}" Margin="0,0,0,14"><DockPanel><TextBlock Text="ⓘ" FontSize="30" Foreground="#A5ABB3" Margin="0,0,18,0"/><TextBlock x:Name="ConfigurationHint" Text="Os dados serão exibidos após preparar o servidor." VerticalAlignment="Center"/></DockPanel></Border>

</StackPanel></ScrollViewer>
<Border Grid.Row="3" BorderBrush="#303236" BorderThickness="0,1,0,0" Background="#191A1C" Padding="24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Pronto para configurar o servidor." FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Este componente não captura a tela nem controla este computador." Foreground="#959AA2" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="⟳   Atualizar" Click="Refresh_Click" Background="#1D6FF2" BorderBrush="#1D6FF2" Margin="18,0,0,0" VerticalAlignment="Center"/></Grid></Border>
</Grid></Grid></Window>
