<Window x:Class="RemoteDesk.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RemoteDesk — Instalação do cliente" Height="650" Width="680" MinHeight="320" MinWidth="460" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#1C1C1C" Foreground="#F1F1F1" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F1" /></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#161616"/><Setter Property="Foreground" Value="#EFEFEF"/><Setter Property="BorderBrush" Value="#474747"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#1D6FF2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#1D6FF2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1D6FF2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9D9D9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <Grid Margin="24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,23">
      <Image Source="RemoteDesk.ico" Width="42" Height="42" Margin="0,0,12,0"/>
      <StackPanel><TextBlock Text="RemoteDesk" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Instalação do cliente Windows" Foreground="#AFAFAF" FontSize="12"/></StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="#242424" BorderBrush="#383838" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,22">
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="StepOne" Text="1  Instalação" FontWeight="SemiBold" Foreground="#1D6FF2"/><TextBlock Text="────────" Foreground="#505050" Margin="24,0"/><TextBlock x:Name="StepTwo" Text="2  Conexão" Foreground="#AFAFAF"/></StackPanel>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
      <StackPanel x:Name="InstallationPage">
        <TextBlock Text="Prepare este computador" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="Instale o cliente e informe o servidor principal na próxima etapa." Foreground="#B7B7B7" TextWrapping="Wrap" Margin="0,0,0,25"/>
        <TextBlock Text="Pasta do aplicativo" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="Destination" IsReadOnly="True" IsTabStop="False"/><CheckBox x:Name="StartWithWindows" Content="Iniciar com o Windows, minimizado na bandeja" IsChecked="True" Margin="0,18,0,0"/><TextBlock Text="Após entrar na sua conta Windows. Acesso por aprovação ou senha configurada no destino." Foreground="#A8A8A8" Margin="0,6,0,0"/>
        <Border Background="#242424" BorderBrush="#383838" BorderThickness="1" Padding="18" CornerRadius="4" Margin="0,22,0,0"><StackPanel><TextBlock Text="Instalação para o usuário atual" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Os atalhos serão criados na área de trabalho e no menu Iniciar. Suas configurações, identidade e dispositivos recentes serão preservados durante atualizações." Foreground="#B7B7B7" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border>
        <TextBlock Text="Feche o RemoteDesk antes de continuar." Foreground="#B7B7B7" Margin="0,19,0,0"/>
      </StackPanel>
      <StackPanel x:Name="ConnectionPage" Visibility="Collapsed">
        <TextBlock Text="Conecte ao seu servidor" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Use o endereço informado pelo responsável pelo servidor RemoteDesk." Foreground="#B7B7B7" Margin="0,0,0,17"/>
        <TextBlock Text="Endereço do servidor principal *" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBox x:Name="ServerAddress" TextChanged="Configuration_Changed" ToolTip="Exemplo: wss://192.168.1.10:5081/ws"/>
        <TextBlock Text="Exemplo: wss://192.168.1.10:5081/ws" Foreground="#989898" FontSize="11" Margin="0,5,0,14"/>
        <TextBlock Text="SHA256 do certificado do servidor (opcional)" Margin="0,0,0,7"/>
        <TextBox x:Name="ServerFingerprint" TextChanged="Configuration_Changed" FontFamily="Consolas" FontSize="12"/>
        <CheckBox x:Name="SameCertificate" Content="O relay utiliza o mesmo certificado do servidor" Checked="SameCertificate_Changed" Unchecked="SameCertificate_Changed" Margin="0,13,0,12"/>
        <TextBlock Text="SHA256 do certificado do relay (opcional)" Margin="0,0,0,7"/>
        <TextBox x:Name="RelayFingerprint" TextChanged="Configuration_Changed" FontFamily="Consolas" FontSize="12"/>
        <TextBlock Text="Para certificados autoassinados, confira e informe os fingerprints fornecidos pelo administrador. Deixe em branco somente para certificados confiáveis pelo Windows." Foreground="#989898" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,11,0,0"/>
      </StackPanel>
    </Grid></ScrollViewer>
    <TextBlock Grid.Row="3" x:Name="Status" Text="Escolha a inicialização automática e configure seu servidor na próxima etapa." Foreground="#ABABAB" TextWrapping="Wrap" MinHeight="35" Margin="0,14,0,12"/>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" Text="CLIENTE REMOTEDESK" Foreground="#777777" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="Back" Content="Voltar" Click="Back_Click" Visibility="Collapsed" Background="#2B2B2B" BorderBrush="#4A4A4A" Margin="0,0,10,0"/><Button Grid.Column="2" x:Name="Install" Content="Continuar" Click="Install_Click" MinWidth="140"/></Grid>
  </Grid>
</Window>
